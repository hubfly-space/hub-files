HUBFILES_API_PORT=10015
HUBFILES_MGMT_PORT=10014
HUBFILES_UI_DIR=/opt/hubfly-files/web
HUBFILES_DEMO_DIR=/opt/hubfly-files/demo
HUBFILES_MAX_UPLOAD_BYTES=104857600

# Host SMB mounts are disabled by default because they require OS mount privileges.
HUBFILES_ALLOW_HOST_MOUNTS=false
HUBFILES_MOUNT_ROOT=/mnt/hubfiles
